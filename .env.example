# Copy to .env (never commit .env). Every value has a working default for the demo.

# ---- Adapty ----
# mock: serve the captured fixtures. live: call api-admin.adapty.io with the token below.
ADAPTY_MODE=mock
# captured: the real answers recorded from the Lumen app. expanded: the larger synthetic demo set (backend/scripts/expand_seed.py).
ADAPTY_FIXTURES=captured
ADAPTY_APP_ID=9c35cea9-1655-4af3-9f05-ac16f383e91d
# Developer token. Leave empty to read %LOCALAPPDATA%\adapty\config.json written by `adapty auth login`.
ADAPTY_TOKEN=
ADAPTY_API_URL=https://api-admin.adapty.io/api/v1/developer
# Live writes (stop, start, replace) stay blocked unless this is true AND the action was approved in the UI.
REFEREE_ALLOW_LIVE_WRITES=false

# ---- LLM narration (never does math) ----
# auto: api if ANTHROPIC_API_KEY is set, else the Claude Code CLI (subscription), else deterministic templates.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_MODEL=sonnet

# ---- Server ----
REFEREE_PORT=8010
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional fixed "now" for reproducible demos (ISO 8601). Empty = real clock.
REFEREE_NOW=
